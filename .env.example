# =============================================================================
# WorkSure Server — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running docker-compose.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Database ---
POSTGRES_DB=worksure_db
POSTGRES_USER=worksure_user
POSTGRES_PASSWORD=             # REQUIRED: Set a strong password
DATABASE_URL=                  # REQUIRED: e.g., postgresql://worksure_user:<password>@postgres:5432/worksure_db

# --- JWT ---
JWT_SECRET=                    # REQUIRED: Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_EXPIRES_IN=24h             # Token expiry duration

# --- Application ---
NODE_ENV=development
PORT=8000

# --- Paystack ---
PAYSTACK_SECRET_KEY=           # REQUIRED for payment processing
PAYSTACK_WEBHOOK_SECRET=       # REQUIRED for secure webhook validation

# --- Platform ---
PLATFORM_FEE_PERCENT=10
APP_URL=http://localhost:3000

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
