# =============================================================================
# WorkSure Server — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running docker-compose or local dev.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Database ---
POSTGRES_DB=worksure_db
POSTGRES_USER=worksure_user
POSTGRES_PASSWORD=             # REQUIRED: Set a strong password
DATABASE_URL=                  # REQUIRED: e.g., postgresql://worksure_user:<password>@localhost:5432/worksure_db

# --- Redis (Render Managed Internal Service or Local) ---
REDIS_URL=redis://localhost:6379 # REQUIRED: In production, use private Render internal Redis (redis://red-xxx:6379)

# --- JWT ---
JWT_SECRET=                    # REQUIRED: Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_EXPIRES_IN=24h             # Token expiry duration (e.g. 24h, 1d)

# --- Application ---
NODE_ENV=development
PORT=8000
TRUST_PROXY=false
APP_URL=http://localhost:3000

# --- Paystack ---
PAYSTACK_SECRET=               # REQUIRED: sk_test_... or sk_live_...
PAYSTACK_PUBLIC=               # REQUIRED: pk_test_... or pk_live_...
PAYSTACK_SECRET_KEY=           # Optional alias for backward compatibility
PAYSTACK_WEBHOOK_SECRET=       # REQUIRED: For validating Paystack signature headers

# --- Cloudinary ---
CLOUDINARY_NAME=               # REQUIRED: Cloudinary cloud name
CLOUDINARY_KEY=                # REQUIRED: Cloudinary API key
CLOUDINARY_SECRET=             # REQUIRED: Cloudinary API secret

# --- Platform & Monitoring ---
PLATFORM_FEE_PERCENT=10
SENTRY_DSN=                    # Optional: Sentry error tracking DSN
METRICS_TOKEN=dev-metrics-token # Token for /metrics endpoint

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
