generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CLIENT
  ARTISAN
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  FINANCE_ADMIN
  DISPUTE_ADMIN
  VERIFICATION_ADMIN
  SUPPORT_ADMIN
  CONTENT_MODERATOR
  ANALYTICS_ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  EVIDENCE_COLLECTION
  AWAITING_RESPONSE
  ADMIN_INVESTIGATION
  DECISION_PENDING
  RESOLVED
  CLOSED
}

enum DisputeDecision {
  CLIENT_WINS
  ARTISAN_WINS
  SPLIT_DECISION
  CANCELLED
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  FORCE_CLOSED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  VIEWED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  PENDING_PAYMENT
  FUNDED
  ACTIVE
  IN_PROGRESS
  CLIENT_CONFIRMED
  READY_FOR_PAYOUT
  COMPLETED
  PAID_OUT
  CANCELLED
  DISPUTED
  REFUNDED
  PAYMENT_FAILED
  EXPIRED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum TransactionType {
  PAYMENT
  FUNDING
  ESCROW_HOLD
  ESCROW_RELEASE
  PLATFORM_FEE
  REFUND
  TRANSFER
  PAYOUT
  ADJUSTMENT_NOTE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditEntityType {
  USER
  DISPUTE
  JOB
  CONTRACT
  REPORT
}

enum FinancialEventType {
  FUND_REQUESTED
  FUND_CONFIRMED
  RELEASE_REQUESTED
  RELEASE_CONFIRMED
  REFUND_REQUESTED
  REFUND_CONFIRMED
}

enum KycDocumentType {
  ID
  ADDRESS
  CERTIFICATE
}

enum KycDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id                          String      @id
  name                        String
  email                       String      @unique
  passwordHash                String
  passwordResetTokenHash      String?     @unique
  passwordResetTokenExpiresAt DateTime?
  passwordResetRequestedAt    DateTime?
  role                        UserRole
  adminRoles                  AdminRole[]
  status                      UserStatus
  artisanVerified             Boolean     @default(false)
  emailVerified               Boolean     @default(false)
  paystackRecipientCode       String?
  payoutBankCode              String?
  payoutAccountNumber         String?
  payoutAccountName           String?
  phone                       String?
  createdAt                   DateTime
  lastLoginAt                 DateTime?
  updatedAt                   DateTime    @updatedAt

  // Relations
  artisanProfile      ArtisanProfile?
  artisanVerification ArtisanVerification?
  kycDocuments        KycDocument[]
  sentProposals       Proposal[]           @relation("SentProposals")
  receivedProposals   Proposal[]           @relation("ReceivedProposals")
  clientContracts     Contract[]           @relation("ClientContracts")
  artisanContracts    Contract[]           @relation("ArtisanContracts")
  clientJobs          Job[]                @relation("ClientJobs")
  artisanJobs         Job[]                @relation("ArtisanJobs")
  sentReviews         Review[]             @relation("SentReviews")
  receivedReviews     Review[]             @relation("ReceivedReviews")
  notifications       Notification[]
  transactions        Transaction[]
  payments            Payment[]            @relation("UserPayments")
  clientDisputes      Dispute[]            @relation("ClientDisputes")
  artisanDisputes     Dispute[]            @relation("ArtisanDisputes")
  ledgerAccounts      LedgerAccount?
  suggestedCategories CategorySuggestion[] @relation("SuggestedCategories")
  reviewedCategories  CategorySuggestion[] @relation("ReviewedCategories")
  revisionRequests    RevisionRequest[]
}

model Dispute {
  id                 String            @id @default(uuid(7))
  contractId         String            @unique
  initiatorId        String
  clientId           String
  artisanId          String
  amount             Int
  status             DisputeStatus     @default(OPEN)
  reason             String
  description        String
  resolutionDecision DisputeDecision?
  resolutionSplit    Json?
  resolvedAt         DateTime?
  resolvedBy         String?
  resolutionNotes    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  history            DisputeHistory[]
  evidence           DisputeEvidence[]

  // Relations
  client   User     @relation("ClientDisputes", fields: [clientId], references: [id])
  artisan  User     @relation("ArtisanDisputes", fields: [artisanId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id])

  @@index([clientId, status])
  @@index([artisanId, status])
  @@index([contractId])
}

model DisputeHistory {
  id        String   @id @default(uuid(7))
  disputeId String
  action    String
  at        DateTime @default(now())
  by        String
  notes     String?
  metadata  Json?
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, at])
}

enum EvidenceType {
  IMAGE
  VIDEO
  PDF
  MESSAGE_REFERENCE
  DELIVERABLE_REFERENCE
  OTHER
}

model DisputeEvidence {
  id          String       @id @default(uuid(7))
  disputeId   String
  submittedBy String
  type        EvidenceType
  url         String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
}

model Job {
  id               String    @id @default(uuid(7))
  title            String
  description      String?
  budget           Int?
  clientId         String
  artisanId        String?
  contractId       String?   @unique
  amount           Int?
  status           JobStatus
  location         String?
  requiredSkills   Json?
  category         String?
  deadline         DateTime?
  requirements     String?
  flagged          Boolean   @default(false)
  forceClosedAt    DateTime?
  forceCloseReason String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  client    User       @relation("ClientJobs", fields: [clientId], references: [id])
  artisan   User?      @relation("ArtisanJobs", fields: [artisanId], references: [id])
  contract  Contract?
  proposals Proposal[]

  @@index([clientId, status])
  @@index([artisanId, status])
  @@index([category])
  @@index([status, createdAt])
  @@index([title, description])
  @@index([requiredSkills], type: Gin)
}

model Transaction {
  id            String            @id @default(uuid(7))
  userId        String
  type          TransactionType
  amount        Int
  status        TransactionStatus @default(PENDING)
  reference     String            @unique
  metadata      Json?
  createdAt     DateTime          @default(now())
  completedAt   DateTime?
  failedAt      DateTime?
  failureReason String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([type, status])
  @@index([metadata], type: Gin)
}

model ArtisanProfile {
  id                 String   @id @default(uuid(7))
  userId             String   @unique
  bio                String?
  skills             Json     @default("[]")
  experience         String?
  portfolio          Json     @default("[]")
  verified           Boolean  @default(false)
  rating             Float?   @default(0)
  reviewCount        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  platformFeePercent Float?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verified, rating])
  @@index([skills], type: Gin)
}

model Proposal {
  id                String         @id @default(uuid(7))
  jobId             String
  artisanId         String
  clientId          String
  amount            Int
  message           String
  estimatedDuration String?
  status            ProposalStatus @default(DRAFT)
  version           Int            @default(1)

  // Job Snapshot
  jobSnapshotTitle    String?
  jobSnapshotBudget   Int?
  jobSnapshotType     String?
  jobSnapshotCategory String?
  jobSnapshotLocation String?
  jobSnapshotCurrency String? @default("NGN")

  // Artisan Snapshot
  artisanSnapshotName               String?
  artisanSnapshotAvatarUrl          String?
  artisanSnapshotVerificationStatus Boolean?
  artisanSnapshotRating             Float?
  artisanSnapshotCompletedJobs      Int?
  artisanSnapshotResponseRate       Float?

  // Shortlist Metadata
  shortlistedAt     DateTime?
  shortlistedBy     String?
  shortlistPriority Int?

  // Expiration
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  artisan  User      @relation("SentProposals", fields: [artisanId], references: [id])
  client   User      @relation("ReceivedProposals", fields: [clientId], references: [id])
  contract Contract?

  attachments    ProposalAttachment[]
  timelineEvents ProposalTimelineEvent[]
  decision       ProposalDecision?

  @@unique([jobId, artisanId])
  @@index([jobId, status])
  @@index([artisanId, status])
}

model ProposalAttachment {
  id         String   @id @default(uuid(7))
  proposalId String
  fileUrl    String
  fileName   String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model ProposalTimelineEvent {
  id         String         @id @default(uuid(7))
  proposalId String
  status     ProposalStatus
  actorId    String
  notes      String?
  createdAt  DateTime       @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

model ProposalDecision {
  id         String   @id @default(uuid(7))
  proposalId String   @unique
  decision   String
  decidedBy  String
  reason     String?
  decidedAt  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model Contract {
  id                       String         @id @default(uuid(7))
  jobId                    String         @unique
  proposalId               String         @unique
  clientId                 String
  artisanId                String
  amount                   Int
  status                   ContractStatus @default(DRAFT)
  currency                 String         @default("NGN")
  paystackReference        String?        @unique
  paystackAuthorizationUrl String?
  paystackAccessCode       String?
  fundedPaymentId          String?
  payoutRequestedAt        DateTime?
  paidOutAt                DateTime?
  refundedAt               DateTime?
  refundReason             String?
  payoutFailureReason      String?

  // Lifecycle timestamps
  fundedAt    DateTime?
  activatedAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Completion confirmations
  clientConfirmedCompletion  Boolean   @default(false)
  clientConfirmedAt          DateTime?
  artisanConfirmedCompletion Boolean   @default(false)
  artisanConfirmedAt         DateTime?

  // Payment tracking
  escrowReleased      Boolean   @default(false)
  escrowReleasedAt    DateTime?
  platformFeeDeducted Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  job             Job              @relation(fields: [jobId], references: [id])
  proposal        Proposal         @relation(fields: [proposalId], references: [id])
  client          User             @relation("ClientContracts", fields: [clientId], references: [id])
  artisan         User             @relation("ArtisanContracts", fields: [artisanId], references: [id])
  conversation    Conversation?
  review          Review?
  payments        Payment[]
  ledgerEntries   LedgerEntry[]
  financialEvents FinancialEvent[]
  disputes        Dispute[]
  deliverables    Deliverable[]

  @@index([clientId, status])
  @@index([artisanId, status])
  @@index([status, activatedAt])
}

model Conversation {
  id         String   @id @default(uuid(7))
  contractId String   @unique
  clientId   String
  artisanId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contract Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([clientId, updatedAt])
  @@index([artisanId, updatedAt])
}

model Message {
  id             String      @id @default(uuid(7))
  conversationId String
  senderId       String
  content        String?
  type           MessageType @default(TEXT)
  fileUrl        String?
  fileType       String?
  fileName       String?
  fileSize       Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Review {
  id              String   @id @default(uuid(7))
  contractId      String   @unique
  clientId        String
  artisanId       String
  rating          Int
  comment         String?
  categories      Json?
  workQuality     Int?
  communication   Int?
  timeliness      Int?
  professionalism Int?
  evidence        Json?
  isPublic        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  // Relations
  contract Contract @relation(fields: [contractId], references: [id])
  client   User     @relation("SentReviews", fields: [clientId], references: [id])
  artisan  User     @relation("ReceivedReviews", fields: [artisanId], references: [id])

  @@index([artisanId, rating])
}

model Notification {
  id         String    @id @default(uuid(7))
  userId     String
  type       String    @default("system_update")
  title      String
  message    String
  entityId   String?
  entityType String?
  actionUrl  String?
  priority   String    @default("medium")
  read       Boolean   @default(false)
  isArchived Boolean   @default(false)
  metadata   Json?
  createdAt  DateTime
  readAt     DateTime?
  archivedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
}

model AuditLog {
  id          String          @id @default(uuid(7))
  action      String
  entityType  AuditEntityType
  entityId    String
  performedBy String
  performedAt DateTime
  metadata    Json?

  @@index([entityType, performedAt])
}

model Payment {
  id                       String        @id @default(uuid(7))
  contractId               String
  userId                   String
  amount                   Int
  status                   PaymentStatus @default(PENDING)
  currency                 String        @default("NGN")
  gateway                  String?
  paymentMethod            String?
  paymentReference         String?
  paystackAccessCode       String?
  paystackAuthorizationUrl String?
  paystackTransactionId    String?
  recipientCode            String?
  transferCode             String?
  verificationCode         String?
  isVerified               Boolean       @default(false)
  metadata                 Json?
  failureReason            String?
  createdAt                DateTime      @default(now())
  verifiedAt               DateTime?
  completedAt              DateTime?
  refundedAt               DateTime?

  // Relations
  contract      Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user          User          @relation("UserPayments", fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@index([contractId, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model KycDocument {
  id              String            @id @default(uuid(7))
  userId          String
  documentType    KycDocumentType
  documentUrl     String
  status          KycDocumentStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

model IdempotencyKey {
  id          String    @id @default(uuid(7))
  key         String
  namespace   String    @default("default")
  lockedAt    DateTime?
  expiresAt   DateTime?
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([namespace, key])
  @@index([createdAt])
  @@index([expiresAt])
}

model FinancialEvent {
  id         String             @id @default(uuid(7))
  contractId String
  type       FinancialEventType
  amount     Int
  actorId    String?
  metadata   Json?
  createdAt  DateTime           @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
  @@index([type, createdAt])
}

enum LedgerAccountType {
  USER_WALLET
  SYSTEM_ESCROW
  SYSTEM_FEE
  EXTERNAL_BANK
}

model LedgerAccount {
  id        String            @id @default(uuid(7))
  name      String
  type      LedgerAccountType
  userId    String?           @unique
  balance   Int               @default(0)
  frozen    Int               @default(0)
  version   Int               @default(1)
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  debitEntries  LedgerEntry[] @relation("DebitAccount")
  creditEntries LedgerEntry[] @relation("CreditAccount")

  @@index([type])
}

model LedgerEntry {
  id              String   @id @default(uuid(7))
  debitAccountId  String
  creditAccountId String
  amount          Int
  contractId      String?
  paymentId       String?
  reference       String
  description     String?
  createdAt       DateTime @default(now())

  debitAccount  LedgerAccount @relation("DebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount LedgerAccount @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  contract      Contract?     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([reference])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([contractId])
}

model VerificationToken {
  id        String   @id @default(uuid(7))
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model SystemLog {
  id        String   @id @default(uuid(7))
  level     String
  context   String?
  message   String
  trace     String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([context, createdAt])
}

model Category {
  id        String   @id @default(uuid(7))
  name      String   @unique
  slug      String   @unique
  isPopular Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills Skill[]
}

model Skill {
  id         String   @id @default(uuid(7))
  name       String
  slug       String   @unique
  categoryId String
  isTrending Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([name, categoryId])
  @@index([categoryId])
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model CategorySuggestion {
  id                String           @id @default(uuid(7))
  name              String
  description       String?
  status            SuggestionStatus @default(PENDING)
  suggestedByUserId String
  reviewedByUserId  String?
  rejectionReason   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  reviewedAt        DateTime?

  suggestedBy User  @relation("SuggestedCategories", fields: [suggestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("ReviewedCategories", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([suggestedByUserId])
}

enum MarketplaceVerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
  SUSPENDED
}

enum FinancialVerificationStatus {
  NOT_STARTED
  PENDING
  PROCESSING
  VERIFIED
  FAILED
  EXPIRED
  RETRY_REQUIRED
}

model ArtisanVerification {
  id                        String                        @id @default(uuid(7))
  userId                    String                        @unique
  marketplaceStatus         MarketplaceVerificationStatus @default(NOT_SUBMITTED)
  marketplaceApprovedAt     DateTime?
  marketplaceRejectedReason String?
  marketplaceReviewerId     String?
  financialProvider         String?                       @default("PAYSTACK")
  financialProviderRef      String?
  financialStatus           FinancialVerificationStatus   @default(NOT_STARTED)
  financialVerifiedAt       DateTime?
  financialFailureReason    String?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([marketplaceStatus])
  @@index([financialStatus])
}

// ----------------------------------------------------------------------------
// DELIVERABLES DOMAIN
// ----------------------------------------------------------------------------

enum DeliverableStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  LOCKED
}

enum AttachmentType {
  FILE
  LINK
}

enum RevisionStatus {
  PENDING
  RESOLVED
}

model Deliverable {
  id          String            @id @default(uuid(7))
  contractId  String
  status      DeliverableStatus @default(NOT_STARTED)
  milestoneId String? // Deferred for future scalability
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  approvedAt  DateTime?

  contract Contract             @relation(fields: [contractId], references: [id])
  versions DeliverableVersion[]

  @@index([contractId])
  @@index([status])
}

model DeliverableVersion {
  id            String   @id @default(uuid(7))
  deliverableId String
  versionNumber Int
  submittedAt   DateTime @default(now())
  artisanNotes  String?

  deliverable Deliverable             @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  attachments DeliverableAttachment[]
  revisions   RevisionRequest[]

  @@unique([deliverableId, versionNumber])
}

model DeliverableAttachment {
  id        String         @id @default(uuid(7))
  versionId String
  type      AttachmentType
  url       String
  name      String
  sizeBytes Int?
  mimeType  String?
  createdAt DateTime       @default(now())

  version DeliverableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model RevisionRequest {
  id              String         @id @default(uuid(7))
  versionId       String
  requestedBy     String
  requestedAt     DateTime       @default(now())
  comment         String
  requiredChanges String
  status          RevisionStatus @default(PENDING)
  dueDate         DateTime?

  version DeliverableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  client  User               @relation(fields: [requestedBy], references: [id])
}

// ----------------------------------------------------------------------------
// AUDIT DOMAIN
// ----------------------------------------------------------------------------

enum AuditDomain {
  AUTHENTICATION
  AUTHORIZATION
  MARKETPLACE
  FINANCIAL
  VERIFICATION
  CONTRACTS
  DELIVERABLES
  DISPUTES
  NOTIFICATIONS
  ADMINISTRATION
  SYSTEM
}

enum AuditActorType {
  SYSTEM
  ANONYMOUS
  USER
  ADMIN
  WORKER
  WEBHOOK
  API
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

model AuditEvent {
  id            String         @id @default(uuid(7))
  domain        AuditDomain
  action        String
  actorType     AuditActorType
  actorId       String?
  targetType    String
  targetId      String
  correlationId String
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  severity      AuditSeverity  @default(INFO)
  timestamp     DateTime       @default(now())

  @@index([timestamp])
  @@index([correlationId])
  @@index([targetId])
  @@index([actorId])
  @@index([metadata], type: Gin)
}
